#!/usr/bin/env python3
#MISE description="Convert git diff to JSON format for hierarchical processing"
#MISE alias="gdj"

"""
Convert git diff output to JSON format.

Outputs JSON array: [{"id": "filepath", "content": "diff content"}]
"""

import subprocess
import sys
import json
import argparse


def get_staged_files():
    """Get list of staged files."""
    result = subprocess.run(
        ["git", "diff", "--cached", "--name-only"],
        capture_output=True,
        text=True,
        check=True
    )
    return [f for f in result.stdout.strip().split('\n') if f]


def get_file_diff(filepath, cached=True):
    """Get diff for a specific file."""
    cmd = ["git", "diff"]
    if cached:
        cmd.append("--cached")
    cmd.extend(["--", filepath])

    result = subprocess.run(
        cmd,
        capture_output=True,
        text=True,
        check=True
    )
    return result.stdout


def get_branch_diff(branch):
    """Get diff between current branch and target branch."""
    # Get list of changed files
    result = subprocess.run(
        ["git", "diff", "--name-only", branch],
        capture_output=True,
        text=True,
        check=True
    )
    files = [f for f in result.stdout.strip().split('\n') if f]

    # Get diffs
    diffs = []
    for filepath in files:
        result = subprocess.run(
            ["git", "diff", branch, "--", filepath],
            capture_output=True,
            text=True,
            check=True
        )
        if result.stdout:
            diffs.append({"id": filepath, "content": result.stdout})

    return diffs


def get_commit_diff(commit):
    """Get diff for a specific commit."""
    # Get list of changed files in commit
    result = subprocess.run(
        ["git", "diff-tree", "--no-commit-id", "--name-only", "-r", commit],
        capture_output=True,
        text=True,
        check=True
    )
    files = [f for f in result.stdout.strip().split('\n') if f]

    # Get diffs
    diffs = []
    for filepath in files:
        result = subprocess.run(
            ["git", "show", f"{commit}:{filepath}"],
            capture_output=True,
            text=True
        )
        if result.returncode == 0 and result.stdout:
            # Get the actual diff
            diff_result = subprocess.run(
                ["git", "diff", f"{commit}^", commit, "--", filepath],
                capture_output=True,
                text=True,
                check=True
            )
            if diff_result.stdout:
                diffs.append({"id": filepath, "content": diff_result.stdout})

    return diffs


def main():
    parser = argparse.ArgumentParser(
        description="Convert git diff to JSON format for hierarchical processing"
    )
    parser.add_argument(
        "--cached",
        action="store_true",
        default=True,
        help="Show staged changes (default: true)"
    )
    parser.add_argument(
        "--working",
        action="store_true",
        help="Show working directory changes (unstaged)"
    )
    parser.add_argument(
        "--branch",
        type=str,
        help="Compare against branch (e.g., main)"
    )
    parser.add_argument(
        "--commit",
        type=str,
        help="Show changes in specific commit"
    )

    args = parser.parse_args()

    # Determine mode
    if args.commit:
        diffs = get_commit_diff(args.commit)
    elif args.branch:
        diffs = get_branch_diff(args.branch)
    elif args.working:
        files = subprocess.run(
            ["git", "diff", "--name-only"],
            capture_output=True,
            text=True,
            check=True
        ).stdout.strip().split('\n')
        files = [f for f in files if f]
        diffs = [
            {"id": f, "content": get_file_diff(f, cached=False)}
            for f in files
            if get_file_diff(f, cached=False)
        ]
    else:
        # Default: staged files
        files = get_staged_files()
        diffs = [
            {"id": f, "content": get_file_diff(f, cached=True)}
            for f in files
            if get_file_diff(f, cached=True)
        ]

    if not diffs:
        print("[]", file=sys.stderr)
        sys.exit(0)

    # Output JSON
    json.dump(diffs, sys.stdout, indent=2)


if __name__ == "__main__":
    main()
