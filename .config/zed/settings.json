{
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "model": "gpt-5.6-luna"
      },
      "type": "registry"
    }
  },
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "agent": {
    "tool_permissions": {
      "default": "allow"
    },
    "dock": "left",
    "default_model": {
      "effort": "medium",
      "enable_thinking": true,
      "provider": "openai-subscribed",
      "model": "gpt-5.6-terra",
    },
    "model_parameters": [],
  },
  "vim_mode": true,
  "vim": {
    "use_system_clipboard": "always",
  },
  "theme": {
    "mode": "system",
    "light": "SunnyDay",
    "dark": "Everforest Dark Hard",
  },
  "buffer_font_family": "FiraCode Nerd Font Mono",
  "buffer_font_size": 10,
  "languages": {
    "Python": {
      "language_servers": ["ty"],
      "formatter": {
        "external": {
          "command": "uvx",
          "arguments": ["black", "--stdin-filename", "{buffer_path}", "-"],
        },
      },
    },
  },
}
